{
  "manifest_version": 3,
  "name": "SIGC-PRO",
  "version": "0.2.255",
  "description": "Melhorias não oficiais para o SIGC (IBGE): exportação de PDF, KML e CSV da Lista de Endereços, e CSV da Agenda.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/leaflet/leaflet.js",
        "vendor/leaflet/leaflet.css",
        "vendor/leaflet/images/*",
        "vendor/pdf-lib/pdf-lib.min.js",
        "vendor/carta-assets/carta-assets.js"
      ],
      "matches": [
        "https://portalweb.ibge.gov.br/*",
        "https://portalweb2.ibge.gov.br/*",
        "https://w3sigcpns2025.ibge.gov.br/*"
      ]
    }
  ],
  "background": {
    "service_worker": "features/gerenciamento-historico/historico-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portalweb.ibge.gov.br/*",
        "https://portalweb2.ibge.gov.br/*",
        "https://w3sigcpns2025.ibge.gov.br/*"
      ],
      "js": [
        "features/gerenciamento-historico/historico-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://portalweb.ibge.gov.br/*",
        "https://portalweb2.ibge.gov.br/*",
        "https://w3sigcpns2025.ibge.gov.br/*"
      ],
      "js": [
        "features/ultimo-movimento-map/ultimo-movimento-map-relay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portalweb.ibge.gov.br/*",
        "https://portalweb2.ibge.gov.br/*",
        "https://w3sigcpns2025.ibge.gov.br/*"
      ],
      "js": [
        "common/sigc-common.js",
        "common/municipios.js",
        "common/sigc-panel.js",
        "features/pdf-export/pdf-export.js",
        "features/kml-export/kml-export.js",
        "features/csv-export/csv-export.js",
        "features/agenda-csv-export/agenda-csv-export.js",
        "features/agenda-slot-checks/agenda-slot-checks.js",
        "features/agenda-slots-abertos/agenda-slots-abertos.js",
        "features/agenda-date-picker/agenda-date-picker.js",
        "features/agenda-day-guide/route-map.js",
        "features/agenda-day-guide/agenda-day-guide.js",
        "features/agenda-lookups/agenda-lookups.js",
        "features/ultimo-movimento-export/ultimo-movimento-export.js",
        "features/ultimo-movimento-map/ultimo-movimento-map.js",
        "features/usuario-lookup/usuario-lookup.js",
        "features/carta-notificacao/carta-notificacao.js",
        "features/gerenciamento-coleta/gerenciamento-parse.js",
        "features/gerenciamento-coleta/gerenciamento-aggregate.js",
        "features/gerenciamento-historico/historico-client.js",
        "features/gerenciamento-historico/historico-agregar.js",
        "features/gerenciamento-historico/historico-view.js",
        "features/gerenciamento-coleta/gerenciamento-report.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
